# Copy to .env.local and fill in values. NEVER commit .env.local.

# Supabase Postgres — transaction pooler (port 6543), used by the app at runtime
DATABASE_URL=
# Supabase Postgres — session pooler (port 5432), used by Prisma migrations
DIRECT_URL=

# Supabase Auth (admin login only) — use the new sb_publishable_ key, NOT the legacy anon key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Comma-separated allowlist of admin emails
ADMIN_EMAILS=

# Cloudinary (signed uploads). API secret is server-only — never prefix with NEXT_PUBLIC_
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public site URL (http://localhost:3000 in development)
NEXT_PUBLIC_SITE_URL=
